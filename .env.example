# Backend
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/socialflow
# Use 127.0.0.1 com proxy no mesmo host; use 0.0.0.0 apenas quando o proxy
# estiver em outro namespace/container e a rede externa estiver protegida.
HOST=127.0.0.1
PORT=3001
CORS_ORIGIN=http://localhost:5173
SESSION_TTL_HOURS=168
SESSION_COOKIE_SECURE=false
# OAuth Meta exige lax (padrão) ou none com Secure; strict é incompatível.
SESSION_COOKIE_SAME_SITE=lax
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Habilite somente quando o backend aceitar tráfego exclusivamente de um proxy
# confiável que substitui/sanitiza X-Forwarded-For.
TRUST_PROXY=false
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SOCIAL_TOKEN_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Mídia (em produção, use caminho absoluto em volume persistente)
MEDIA_STORAGE_PATH=./data/media
MEDIA_MAX_IMAGE_BYTES=26214400
MEDIA_MAX_VIDEO_BYTES=262144000

# OAuth Meta (desabilitado por padrão; configure os três valores juntos)
META_OAUTH_ENABLED=false
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v26.0
# Ao habilitar, use no desenvolvimento: http://localhost:3001/auth/meta/callback
META_OAUTH_REDIRECT_URI=
OAUTH_STATE_TTL_SECONDS=600

# Entrega temporária Instagram 6E: configure origem HTTPS pública e chave juntas.
# Gere uma chave Base64 aleatória de 32 bytes EXCLUSIVA; não reutilize outras chaves.
# Vazios preservam Facebook e deixam publicação Instagram indisponível.
META_MEDIA_PUBLIC_ORIGIN=
META_MEDIA_SIGNING_KEY=
# Vazio usa 3600 segundos; intervalo permitido: 1800–7200.
META_MEDIA_URL_TTL_SECONDS=

# Frontend
VITE_POSTS_REPOSITORY=http
VITE_API_URL=http://localhost:3001

# Testes de integração: use exclusivamente um banco com nome terminado em _test.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/socialflow_test
